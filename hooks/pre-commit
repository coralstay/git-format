#!/bin/sh
# pre-commit 훅: 마커 파일로 언어를 감지해 해당 체크 스크립트를 실행하고,
# 전부 통과하면 검증마커를 기록한다(decision-3). 언어 마커가 없으면 무해하게 통과한다.
# 언어별 체크 스크립트가 아직 없거나(GF-4 이전) 실행권한이 없으면 건너뛴다.
set -eu

# template/(GF-9)로 설치된 저장소는 .git/hooks/pre-commit 자체가 git-format 클론을
# 가리키는 심볼릭 링크다. dirname "$0"은 심볼릭 링크를 해석하지 않으므로(링크가 있는
# .git/hooks/를 그대로 가리킴), 링크를 직접 따라가 실제 스크립트 위치를 찾는다.
resolve_self() {
  p="$1"
  while [ -L "$p" ]; do
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *) p="$(dirname "$p")/$target" ;;
    esac
  done
  printf '%s' "$p"
}

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT
GIT_DIR="$(git rev-parse --git-dir)"
readonly GIT_DIR
HOOK_DIR="$(cd "$(dirname "$(resolve_self "$0")")" && pwd)"
readonly HOOK_DIR
CHECKS_DIR="${HOOK_DIR}/checks"
readonly CHECKS_DIR
# gitformat.conf(GF-44)에 이 훅의 내부 기본값(마커 파일명, 언어 감지 마커 파일명)이
# 모여 있다. 값만 여기서 읽고, 이 값들을 쓰는 로직은 이 파일 안에서만 독립적으로
# 유지한다(다른 훅과 함수/변수를 공유하지 않는다는 설계 원칙은 그대로다).
CONF="${HOOK_DIR}/gitformat.conf"
readonly CONF
# gitformat.conf 자체를 못 읽으면(파일 없음/문법 깨짐) 이후 모든 git config
# --file 읽기가 하나씩 실패하면서 원인을 알기 어려운 에러로 이어진다. 여기서
# 미리 검증해 원인을 명확히 알려준다. 이 블록은 CONF를 읽는 다른 파일들에도
# byte-identical하게 있다(tests/consistency.bats가 동일성을 보장).
if ! git config --file "$CONF" --list >/dev/null 2>&1; then
  echo "gitformat: gitformat.conf를 읽을 수 없습니다: ${CONF}" >&2
  exit 1
fi
MARKER="${GIT_DIR}/$(git config --file "$CONF" --get gitformat.markerFile)"
readonly MARKER

MARKER_TS="$(git config --file "$CONF" --get gitformat.marker.ts)"
readonly MARKER_TS
MARKER_JAVA="$(git config --file "$CONF" --get gitformat.marker.java)"
readonly MARKER_JAVA
MARKER_JAVA_GRADLE="$(git config --file "$CONF" --get gitformat.marker.javaGradle)"
readonly MARKER_JAVA_GRADLE
MARKER_CPP="$(git config --file "$CONF" --get gitformat.marker.cpp)"
readonly MARKER_CPP
MARKER_CPP_MAKE="$(git config --file "$CONF" --get gitformat.marker.cppMake)"
readonly MARKER_CPP_MAKE
MARKER_SQL="$(git config --file "$CONF" --get gitformat.marker.sql)"
readonly MARKER_SQL
MARKER_SQL_GLOB="$(git config --file "$CONF" --get gitformat.marker.sqlGlob)"
readonly MARKER_SQL_GLOB

cd "$REPO_ROOT"

# 이전 실행에서 남은 마커는 검증 시작 시점에 무효화한다.
rm -f "$MARKER"

run_check() {
  script="$1"
  if [ -x "$script" ]; then
    "$script" "$REPO_ROOT"
  fi
}

if [ -f "$MARKER_TS" ]; then
  run_check "${CHECKS_DIR}/ts.sh"
fi

python_marker_found=false
for f in $(git config --file "$CONF" --get-all gitformat.marker.python); do
  [ -f "$f" ] && python_marker_found=true
done
if [ "$python_marker_found" = true ]; then
  run_check "${CHECKS_DIR}/python.sh"
fi

# shellcheck disable=SC2086 # 의도적 글롭 확장(예: build.gradle*). 따옴표로 감싸면 리터럴 비교가 되어 깨진다.
if [ -f "$MARKER_JAVA" ] || ls ${MARKER_JAVA_GRADLE} >/dev/null 2>&1; then
  run_check "${CHECKS_DIR}/java.sh"
fi

if [ -f "$MARKER_CPP" ] || [ -f "$MARKER_CPP_MAKE" ]; then
  run_check "${CHECKS_DIR}/cpp.sh"
fi

if [ -f "$MARKER_SQL" ] || git ls-files -- "$MARKER_SQL_GLOB" | grep -q .; then
  run_check "${CHECKS_DIR}/sql.sh"
fi

printf '%s %s\n' "$(date +%s)" "$$" > "$MARKER"

exit 0
