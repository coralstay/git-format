#!/bin/sh
# commit-msg 훅: Conventional Commits 형식 검증(decision-1) + Task-Id 브랜치 강제(decision-4)
#
# 병합 커밋(merge)은 기본 메시지가 컨벤션을 따르지 않으므로 검사에서 제외한다.
# commit-msg 훅은 메시지 파일 경로 인자 1개만 받는다(source/sha1은
# prepare-commit-msg의 인자다 — 예전엔 이걸 착각해서 $2로 "merge"를 확인했는데
# 그 값이 절대 채워지지 않아 병합 예외가 전혀 작동하지 않았다, GF-30). 병합
# 진행 여부는 .git/MERGE_HEAD 존재로 판단한다 — git이 병합 커밋을 만드는 동안,
# commit-msg가 실행되는 시점에 이 파일이 존재함을 실측으로 확인했다.
set -eu

MSG_FILE="$1"
readonly MSG_FILE
GIT_DIR="$(git rev-parse --git-dir)"
readonly GIT_DIR

# template/(GF-9)로 설치된 경우 $0이 심볼릭 링크라 dirname "$0"만으로는 새 저장소의
# .git/hooks/를 잘못 가리킨다 — 링크를 직접 해석한다. 이 함수는 이 파일 안에서만
# 쓰인다(다른 훅도 각자 자기 파일에 동일 함수를 독립적으로 갖고 있다 — 로직은
# 공유하지 않는다는 게 gitformat.conf 도입(GF-44) 이후에도 유지되는 설계 원칙이다).
resolve_self() {
  p="$1"
  while [ -L "$p" ]; do
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *) p="$(dirname "$p")/$target" ;;
    esac
  done
  printf '%s' "$p"
}
HOOK_DIR="$(cd "$(dirname "$(resolve_self "$0")")" && pwd)"
readonly HOOK_DIR
# gitformat.conf(GF-44)에 이 훅의 내부 기본값(마커 파일명, Task-Id 접두어 기본값,
# 예외 브랜치 기본값, AI 도구 식별자, AI-Model 화이트리스트)이 모여 있다. 값만 여기서
# 읽고, 이 값들을 쓰는 로직은 이 파일 안에서만 독립적으로 유지한다.
CONF="${HOOK_DIR}/gitformat.conf"
readonly CONF
# gitformat.conf 자체를 못 읽으면(파일 없음/문법 깨짐) 이후 모든 git config
# --file 읽기가 하나씩 실패하면서 원인을 알기 어려운 에러로 이어진다. 여기서
# 미리 검증해 원인을 명확히 알려준다. 이 블록은 CONF를 읽는 다른 파일들에도
# byte-identical하게 있다(tests/consistency.bats가 동일성을 보장).
if ! git config --file "$CONF" --list >/dev/null 2>&1; then
  echo "gitformat: gitformat.conf를 읽을 수 없습니다: ${CONF}" >&2
  exit 1
fi
MARKER="${GIT_DIR}/$(git config --file "$CONF" --get gitformat.markerFile)"
readonly MARKER

# pre-commit이 통과해 검증마커를 남긴 뒤 commit-msg가 거부하면 커밋 자체가 안
# 생성돼 post-commit이 안 돌고 마커가 안 지워진다. 이후 무관한 --no-verify
# 커밋이 그 스테일 마커를 "검증됨"으로 잘못 소비할 수 있다(GF-31). commit-msg가
# 0이 아닌 상태로 끝나면(exit 1이든 set -e로 인한 비정상 종료든) 항상 마커를
# 지우도록 trap으로 보장한다 — 정상 통과(exit 0)할 때는 post-commit이 마커를
# 써야 하므로 지우지 않는다.
# shellcheck disable=SC2329,SC2317 # trap으로 간접 호출되는데 shellcheck이 이를 못
# 알아봄(함수 자체는 SC2329, 본문 내용은 SC2317 — shellcheck 버전에 따라 둘 중
# 하나만 나올 수도 있어 실제 CI(Ubuntu 러너)에서 SC2317만 걸리는 걸 확인해 함께 추가)
cleanup_marker_on_reject() {
  status=$?
  if [ "$status" -ne 0 ]; then
    rm -f "$MARKER" 2>/dev/null || true
  fi
}
trap cleanup_marker_on_reject EXIT

if [ -f "${GIT_DIR}/MERGE_HEAD" ]; then
  exit 0
fi

# 커밋 타입 목록은 gitformat.conf(다중값 gitformat.type)에서 읽어 파이프로
# 이어붙인다 - .gitmessage에 적힌 사람이 읽는 목록과 일치하는지는
# tests/robustness-commit-msg.bats가 검증한다(런타임 결합 없이 테스트로만 보장).
# git config를 tr과 바로 파이프로 연결하면 안 된다 - POSIX sh엔 pipefail이
# 없어 파이프라인 종료 코드는 마지막 명령(tr, 항상 성공)만 반영한다. git
# config가 실패해도 set -e가 못 잡고 TYPES가 조용히 빈 문자열이 돼버린다
# (그러면 정규식이 ^()...가 돼 모든 커밋이 알 수 없는 이유로 거부된다). 읽기와
# 변환을 분리해 읽기 실패가 set -e로 바로 드러나게 한다.
RAW_TYPES="$(git config --file "$CONF" --get-all gitformat.type)"
readonly RAW_TYPES
TYPES="$(printf '%s' "$RAW_TYPES" | tr '\n' '|')"
TYPES="${TYPES%|}"
readonly TYPES
SUBJECT_LINE="$(grep -v '^#' "$MSG_FILE" | sed -n '1p')"
readonly SUBJECT_LINE

if ! printf '%s' "$SUBJECT_LINE" | grep -qE "^(${TYPES})(\([a-zA-Z0-9_.-]+\))?!?: .+"; then
  echo "commit-msg: 커밋 메시지가 Conventional Commits 형식이 아닙니다." >&2
  echo "  형식: <type>[(scope)][!]: <description>" >&2
  echo "  허용 type: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  예: fix(parser): 빈 입력 처리" >&2
  exit 1
fi

# Task-Id 브랜치 강제: <prefix>-<번호> 패턴이 브랜치명에 없으면 커밋을 거부한다.
# main/master/develop/release/* 등 예외 브랜치와 detached HEAD는 면제한다.
TASK_PREFIX_DEFAULT="$(git config --file "$CONF" --get gitformat.taskPrefixDefault)"
readonly TASK_PREFIX_DEFAULT
TASK_PREFIX="$(git config --get gitformat.taskPrefix 2>/dev/null \
  || printf '%s' "$TASK_PREFIX_DEFAULT")"
# git config --get은 빈 문자열 설정도 성공으로 취급해 위 || 폴백이 안 걸린다
# (GF-35) — 빈 값이면 명시적으로 기본값을 채운다.
[ -n "$TASK_PREFIX" ] || TASK_PREFIX="$TASK_PREFIX_DEFAULT"
readonly TASK_PREFIX
BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || printf '%s' HEAD)"
readonly BRANCH
EXEMPT="$(git config --get-all gitformat.branchExempt 2>/dev/null \
  || git config --file "$CONF" --get-all gitformat.branchExempt)"
readonly EXEMPT

if [ "$BRANCH" != "HEAD" ]; then
  exempt_match=false
  for pattern in $EXEMPT; do
    # shellcheck disable=SC2254 # 의도적 글롭 매칭(예: release/*). 따옴표로 감싸면 리터럴 비교가 되어 깨진다.
    case "$BRANCH" in
      $pattern) exempt_match=true ;;
    esac
  done

  if [ "$exempt_match" = false ]; then
    # 접두어 앞에 글자/숫자가 아닌 문자(또는 문자열 시작)가 오도록 앵커링한다
    # (GF-34) — 안 그러면 예: taskPrefix=ID일 때 "valid-42-fix"의 "id-4"
    # 부분 문자열이 잘못 매치된다.
    if ! printf '%s' "$BRANCH" | grep -qiE "(^|[^a-zA-Z0-9])${TASK_PREFIX}-[0-9]+"; then
      echo "commit-msg: 브랜치명에 ${TASK_PREFIX}-<번호> 패턴이 없습니다 (현재 브랜치: ${BRANCH})." >&2
      echo "  예: ${TASK_PREFIX}-12-install-script" >&2
      echo "  Task-Id 없이 커밋하려면 예외 브랜치(main/master/develop/release/*)에서 작업하세요." >&2
      exit 1
    fi
  fi
fi

# AI-Model 존재/화이트리스트 강제(decision-5). Claude Code는 post-commit이 세션
# 트랜스크립트에서 자동으로 모델을 얻으므로 이 게이트에서 제외한다.
AI_TOOL_CLAUDE_CODE="$(git config --file "$CONF" --get gitformat.aiToolClaudeCode)"
readonly AI_TOOL_CLAUDE_CODE
# cut -d_ -f1 대신 매개변수 확장으로 첫 필드만 뽑는다(외부 프로세스 없이 처리).
AI_TOOL_GATE="${AI_AGENT:-}"
AI_TOOL_GATE="${AI_TOOL_GATE%%_*}"
readonly AI_TOOL_GATE
if [ -n "$AI_TOOL_GATE" ] && [ "$AI_TOOL_GATE" != "$AI_TOOL_CLAUDE_CODE" ]; then
  CONFIGURED_MODEL="$(git config --get gitformat.aiModel 2>/dev/null || printf '%s' '')"
  readonly CONFIGURED_MODEL
  if [ -z "$CONFIGURED_MODEL" ]; then
    echo "commit-msg: AI 도구(${AI_TOOL_GATE})가 감지됐지만 gitformat.aiModel이 설정되지 않았습니다." >&2
    echo "  git config gitformat.aiModel <model-id> 로 설정하세요." >&2
    exit 1
  fi

  KNOWN_MODELS="$(git config --file "$CONF" --get-all gitformat.knownModel \
    2>/dev/null || printf '%s' '')"
  readonly KNOWN_MODELS
  if [ -n "$KNOWN_MODELS" ]; then
    known_model_found=false
    for m in $KNOWN_MODELS; do
      [ "$m" = "$CONFIGURED_MODEL" ] && known_model_found=true
    done
    if [ "$known_model_found" = false ]; then
      echo "commit-msg: gitformat.aiModel 값 '${CONFIGURED_MODEL}'이 알려진 모델 목록에 없습니다." >&2
      echo "  hooks/gitformat.conf의 gitformat.knownModel 항목에 추가하세요." >&2
      exit 1
    fi
  fi
fi

exit 0
